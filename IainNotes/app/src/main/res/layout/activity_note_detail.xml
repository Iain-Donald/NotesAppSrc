<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/appSurface">

    <!-- Notify toggle — left of header -->
    <ImageButton
        android:id="@+id/btnNotify"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/outline_notifications_off_24"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Toggle notification"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        app:tint="@color/icon_accent"
        app:layout_constraintTop_toTopOf="@id/header"
        app:layout_constraintBottom_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/header" />

    <!-- Page title -->
    <TextView
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textSize="16sp"
        android:padding="8dp"
        android:fontFamily="@font/inter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnNotify"
        app:layout_constraintEnd_toStartOf="@id/btnEditNote" />

    <!--View
        android:id="@+id/divider2"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/borderBlend"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" /-->

    <!-- Edit note title — right of header -->
    <ImageButton
        android:id="@+id/btnEditNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/outline_edit_square_24"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Edit note title"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingLeft="8dp"
        android:paddingRight="16dp"
        app:tint="@color/icon_accent"
        app:layout_constraintTop_toTopOf="@id/header"
        app:layout_constraintBottom_toBottomOf="@id/header"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Alarm section container — hidden by default, pushes content down when shown -->
    <LinearLayout
        android:id="@+id/layoutAlarmSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Alarm list — constrained to half screen via maxHeight -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAlarms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="300dp"
            android:nestedScrollingEnabled="true" />

        <!-- Add alarm button inside the panel -->
        <Button
            android:id="@+id/btnAddAlarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ Add Alarm"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            app:backgroundTint="@color/exp5" />

    </LinearLayout>

    <!--linear layout or whatever div eq goes here to wrap the button and the text label for it and change the click listener to listen for a click on the button AND on the div area.-->

    <!--TextView
        android:id="@+id/btnToggleAlarmsLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textSize="16sp"
        android:text="Note alarms"
        android:padding="8dp"
        android:fontFamily="@font/inter"
        android:textColor="@color/textL2_5"
        app:layout_constraintTop_toTopOf="@id/btnToggleAlarms"
        app:layout_constraintBottom_toBottomOf="@id/btnToggleAlarms"
        app:layout_constraintEnd_toStartOf="@id/btnToggleAlarms" /-->
    <!-- Toggle alarm panel — circular FAB style -->
    <!--com.google.android.material.floatingactionbutton.FloatingActionButton-->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnToggleAlarms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/outline_alarm_24"
        android:contentDescription="Toggle alarms"
        app:backgroundTint="@color/exp5"
        app:tint="@color/white"
        app:fabSize="mini"
        app:layout_constraintTop_toBottomOf="@id/layoutAlarmSection"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggleAlarmsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Note alarms"
        android:textSize="16sp"
        android:fontFamily="@font/inter"
        android:textColor="@color/textL2_5"
        android:minHeight="0dp"
        android:minWidth="0dp"
        app:backgroundTint="@android:color/transparent"
        app:rippleColor="?attr/colorControlHighlight"
        app:strokeWidth="2dp"
        app:layout_constraintTop_toTopOf="@id/btnToggleAlarms"
        app:layout_constraintBottom_toBottomOf="@id/btnToggleAlarms"
        app:layout_constraintEnd_toStartOf="@id/btnToggleAlarms"/-->

    <!--View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="@color/borderBlend"
        app:layout_constraintTop_toBottomOf="@id/btnToggleAlarms"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" /-->

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:padding="0dp"
        android:layout_marginRight="0dp"
        android:background="@color/borderBlend"
        app:layout_constraintTop_toBottomOf="@id/btnToggleAlarms"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.example.app.editor.NoScrollEditText
        android:id="@+id/etNoteContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:hint="> Write here"
        android:gravity="top|start"
        android:paddingTop="4dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp"
        android:paddingLeft="16dp"
        android:inputType="textMultiLine|textCapSentences"
        android:textSize="16sp"
        android:fontFamily="@font/interreg"
        android:textColor="@color/notetext"
        android:background="@color/appBackground"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnSaveNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="Save note"
        android:src="@drawable/outline_save_24"
        app:backgroundTint="@color/sylf"
        app:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>