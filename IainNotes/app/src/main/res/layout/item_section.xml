<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:clickable="true"
	android:focusable="true"
	android:minHeight="64dp"
	android:paddingTop="12dp"
	android:paddingBottom="16dp"
	android:paddingRight="16dp">

	<View
		android:id="@+id/colorBar"
		android:layout_width="3dp"
		android:layout_height="0dp"
		android:visibility="gone"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tvSectionName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:fontFamily="@font/intersb"
        android:gravity="center_vertical"
		android:textColor="@color/buttonL2"
		android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/colorBar"
        app:layout_constraintEnd_toStartOf="@id/btnDeleteSection"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvSectionHint" />

    <TextView
        android:id="@+id/tvSectionHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Long press to rename"
        android:textSize="11sp"
		android:fontFamily="@font/interreg"
        android:textColor="#AAAAAA"
		android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/colorBar"
        app:layout_constraintEnd_toStartOf="@id/btnDeleteSection"
        app:layout_constraintTop_toBottomOf="@id/tvSectionName"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageButton
        android:id="@+id/btnPin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/outline_push_pin_24"
        android:contentDescription="Pin note"
        android:padding="8dp"
        app:tint="@color/buttonL2"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toStartOf="@id/btnDeleteSection"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageButton
        android:id="@+id/btnDeleteSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@android:drawable/ic_menu_delete"
        android:contentDescription="Delete section"
        android:padding="8dp"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintBottom_toBottomOf="parent"
		 />

</androidx.constraintlayout.widget.ConstraintLayout>